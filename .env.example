# PostgreSQL
POSTGRES_USER=cias
POSTGRES_PASSWORD=cias_password
POSTGRES_DB=cias_db
DATABASE_URL=postgresql://cias:cias_password@db:5432/cias_db

# JWT
SECRET_KEY=change_this_to_a_strong_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (string simple o JSON array)
CORS_ORIGINS=http://localhost:3000

# Código requerido para registrar auditores — cambiar antes de producción
AUDITOR_REGISTRATION_SECRET=change_this_to_a_strong_random_secret

# Entorno — establecer "production" para activar validaciones de secrets
APP_ENV=development
